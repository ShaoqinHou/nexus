{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs'),p=require('path'),cp=require('child_process');let d=process.cwd();while(d!==p.dirname(d)&&!fs.existsSync(p.join(d,'.codex/scripts/nexus-workflow.mjs')))d=p.dirname(d);const s=p.join(d,'.codex/scripts/nexus-workflow.mjs');if(!fs.existsSync(s)){console.error('Nexus hook script not found');process.exit(0)}const r=cp.spawnSync(process.execPath,[s,'hook','session-start'],{stdio:'inherit'});process.exit(r.status??1)\"",
            "timeout": 30,
            "statusMessage": "Loading Nexus Codex state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs'),p=require('path'),cp=require('child_process');let d=process.cwd();while(d!==p.dirname(d)&&!fs.existsSync(p.join(d,'.codex/scripts/nexus-workflow.mjs')))d=p.dirname(d);const s=p.join(d,'.codex/scripts/nexus-workflow.mjs');if(!fs.existsSync(s)){console.error('Nexus hook script not found');process.exit(0)}const r=cp.spawnSync(process.execPath,[s,'hook','pre-tool-use'],{stdio:'inherit'});process.exit(r.status??1)\"",
            "timeout": 30,
            "statusMessage": "Checking Nexus workflow gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs'),p=require('path'),cp=require('child_process');let d=process.cwd();while(d!==p.dirname(d)&&!fs.existsSync(p.join(d,'.codex/scripts/nexus-workflow.mjs')))d=p.dirname(d);const s=p.join(d,'.codex/scripts/nexus-workflow.mjs');if(!fs.existsSync(s)){console.error('Nexus hook script not found');process.exit(0)}const r=cp.spawnSync(process.execPath,[s,'hook','post-tool-use'],{stdio:'inherit'});process.exit(r.status??1)\"",
            "timeout": 30,
            "statusMessage": "Registering Nexus workflow state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs'),p=require('path'),cp=require('child_process');let d=process.cwd();while(d!==p.dirname(d)&&!fs.existsSync(p.join(d,'.codex/scripts/nexus-workflow.mjs')))d=p.dirname(d);const s=p.join(d,'.codex/scripts/nexus-workflow.mjs');if(!fs.existsSync(s)){console.error('Nexus hook script not found');process.exit(0)}const r=cp.spawnSync(process.execPath,[s,'hook','stop'],{stdio:'inherit'});process.exit(r.status??1)\"",
            "timeout": 30,
            "statusMessage": "Checking Nexus handover state"
          }
        ]
      }
    ]
  }
}
