  "inventory": {
    "root": ".codex",
    "allowedRootFiles": [
      ".codex/README.md",
      ".codex/config.toml",
      ".codex/hooks.json"
    ],
    "allowedRootDirectories": [
      ".codex/agents/",
      ".codex/archive/",
      ".codex/dashboard/",
      ".codex/knowledge/",
      ".codex/scripts/",
      ".codex/workflow/"
    ],
    "runtimeDirectories": [
      ".codex/workflow/state/",
      ".codex/workflow/runtime/"
    ],
    "runtimeTrackedAllowlist": [
      ".codex/workflow/state/.gitignore",
      ".codex/workflow/runtime/.gitignore"
    ],
    "allowedArtifactDirectories": [
      ".codex/workflow/artifacts/screenshots/guide-browser-final/",
      ".codex/workflow/artifacts/screenshots/server-final/",
      ".codex/workflow/artifacts/screenshots/visual-zoo-guide/"
    ],
    "allowedArtifactExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".json"
    ],
    "artifactRetention": {
      "maxTotalBytes": 31457280,
      "maxFileBytes": 7340032,
      "rule": "Artifacts are bounded evidence attachments. Keep policy-approved, record-linked screenshots/summaries; regenerate or archive old raw captures instead of letting this folder become project memory."
    },
    "workflowRootFiles": [
      ".codex/workflow/current-state.md",
      ".codex/workflow/capabilities.md",
      ".codex/workflow/dependency-audit-baseline.json",
      ".codex/workflow/principles.md",
      ".codex/workflow/profile.json"
    ],
    "workflowRootDirectories": [
      ".codex/workflow/artifacts/",
      ".codex/workflow/briefs/",
      ".codex/workflow/policy/",
      ".codex/workflow/project/",
      ".codex/workflow/records/",
      ".codex/workflow/research/",
      ".codex/workflow/runtime/",
      ".codex/workflow/scenarios/",
      ".codex/workflow/state/",
      ".codex/workflow/system/",
      ".codex/workflow/templates/"
    ],
    "roleTaxonomy": [
      {
        "path": ".codex/workflow/principles.md",
        "role": "workflow-design-doc",
        "truth": "workflow intention and placement rules",
        "llmLoadPolicy": "read for workflow architecture, migration, or audit work; do not load for routine feature edits unless needed",
        "stalenessRisk": "medium",
        "portingRule": "copy shape and adjust only when the target workflow intentionally changes principles"
      },
      {
        "path": ".codex/workflow/capabilities.md",
        "role": "workflow-design-doc",
        "truth": "capability ownership, gates, and optional/required boundaries",
        "llmLoadPolicy": "read for porting or capability changes",
        "stalenessRisk": "medium",
        "portingRule": "copy shape; rewrite active/optional capability decisions for the target project"
      },
      {
        "path": ".codex/workflow/current-state.md",
        "role": "managed-handover",
        "truth": "compact resumable state with links to records",
        "llmLoadPolicy": "read at session start; keep compact and avoid finalization details that self-stale",
        "stalenessRisk": "high",
        "portingRule": "start fresh from the target project; do not copy Nexus state"
      },
      {
        "path": ".codex/workflow/profile.json",
        "role": "project-profile-data",
        "truth": "project identity, root paths, generated surfaces, and environment variable names",
        "llmLoadPolicy": "load when changing workflow paths, hook dispatch, generated views, or environment assumptions",
        "stalenessRisk": "low",
        "portingRule": "rewrite for the target project before editing wrapper logic"
      },
      {
        "path": ".codex/workflow/dependency-audit-baseline.json",
        "role": "project-policy-data",
        "truth": "explicit expiring npm audit exceptions",
        "llmLoadPolicy": "load only for dependency audit work",
        "stalenessRisk": "high",
        "portingRule": "regenerate or omit for the target project; never copy exceptions blindly"
      },
      {
        "path": ".codex/workflow/policy/",
        "role": "project-policy-data",
        "truth": "machine-consumed classifiers, schemas, gates, guide contracts, design/deployment/routing/intake policy",
        "llmLoadPolicy": "load the specific policy file that owns the rule being changed",
        "stalenessRisk": "low",
        "portingRule": "rewrite first; project-specific facts belong here before scripts"
      },
      {
        "path": ".codex/workflow/project/",
        "role": "project-adapter-source",
        "truth": "canonical project-specific sources for fixed adapter outputs and project workflow overlays",
        "llmLoadPolicy": "load when changing fixed surfaces such as AGENTS.md, WORKFLOW.md, hooks/config, repo skills, CI, or package workflow scripts",
        "stalenessRisk": "medium",
        "portingRule": "rewrite for the target project, then run adapter-check/sync instead of editing installed copies by hand"
      },
      {
        "path": ".codex/workflow/system/",
        "role": "workflow-system-code",
        "truth": "reusable workflow-system architecture notes, adapter contracts, and shared deterministic kernel code",
        "llmLoadPolicy": "read for workflow architecture changes, portability work, or adapter-system changes",
        "stalenessRisk": "medium",
        "portingRule": "copy shape when the reusable system contract is still intended, then verify against target policy"
      },
      {
        "path": ".codex/workflow/system/scripts/workflow-kernel.mjs",
        "role": "workflow-system-code",
        "truth": "shared deterministic workflow CLI implementation, capability switchboard, records, gates, and guide renderer",
        "llmLoadPolicy": "edit for reusable workflow mechanics; do not hardcode project facts here",
        "stalenessRisk": "medium",
        "portingRule": "copy as system code; target projects provide profile, policy, knowledge, records, adapters, and optional capability data"
      },
      {
        "path": ".codex/workflow/system/scripts/workflow-engine.mjs",
        "role": "workflow-system-code",
        "truth": "shared workflow profile, policy, path, TOML, and sanitizer helpers",
        "llmLoadPolicy": "edit for reusable loading and path-policy mechanics only",
        "stalenessRisk": "low",
        "portingRule": "copy as system code; installed .codex/scripts/workflow-engine.mjs is a compatibility shim"
      },
      {
        "path": ".codex/workflow/system/scripts/run-hook.mjs",
        "role": "workflow-system-code",
        "truth": "shared thin hook dispatcher that resolves the active project wrapper from workflow profile data",
        "llmLoadPolicy": "edit only for reusable hook dispatch mechanics; keep project judgment in the kernel, records, skills, and knowledge",
        "stalenessRisk": "low",
        "portingRule": "copy as system code; installed .codex/scripts/run-hook.mjs is an adapter-managed shim"
      },
      {
        "path": ".codex/workflow/system/fixtures/portable-empty/",
        "role": "workflow-system-fixture",
        "truth": "inspectable empty-project bootstrap fixture used by workflow:portability-check",
        "llmLoadPolicy": "read for portability changes or second-project setup; keep source-project facts out",
        "stalenessRisk": "medium",
        "portingRule": "copy as a reference fixture only; target projects rewrite project policy/profile/knowledge and start fresh records"
      },
      {
        "path": ".codex/workflow/scenarios/",
        "role": "project-policy-data",
        "truth": "executable model-routing and failure-path fixtures",
        "llmLoadPolicy": "load for model-routing changes or tests",
        "stalenessRisk": "medium",
        "portingRule": "replace with target-project representative scenarios"
      },
      {
        "path": ".codex/workflow/templates/",
        "role": "workflow-reference-doc",
        "truth": "record body reference shapes and bootstrap checklist",
        "llmLoadPolicy": "load when creating records manually or bootstrapping another project; prefer script commands",
        "stalenessRisk": "medium",
        "portingRule": "copy shape and rewrite command examples/project names"
      },
      {
        "path": ".codex/workflow/briefs/",
        "role": "preserved-user-brief",
        "truth": "long original user request preserved outside chat",
        "llmLoadPolicy": "load only when checking original intent or drift",
        "stalenessRisk": "low",
        "portingRule": "do not copy as target-project live intent; preserve only as migration reference if relevant"
      },
      {
        "path": ".codex/workflow/research/",
        "role": "historical-analysis",
        "truth": "bounded research/audit reports and rationale snapshots",
        "llmLoadPolicy": "load by title when a specific decision history is needed; never bulk-load as current truth",
        "stalenessRisk": "medium",
        "portingRule": "copy selected files only into historical reference, not live policy"
      },
      {
        "path": ".codex/workflow/records/",
        "role": "append-only-evidence",
        "truth": "event-level durable evidence for intent, work slices, patches, reviews, tests, audits, deployments, and decisions",
        "llmLoadPolicy": "read index/current state first, then open only referenced records needed for the task",
        "stalenessRisk": "low",
        "portingRule": "start fresh; do not copy Nexus records as target-project evidence"
      },
      {
        "path": ".codex/workflow/artifacts/",
        "role": "generated-evidence-artifact",
        "truth": "screenshots and summaries referenced by records or generated guides",
        "llmLoadPolicy": "open only when validating browser/visual evidence",
        "stalenessRisk": "medium",
        "portingRule": "regenerate for the target project"
      },
      {
        "path": ".codex/workflow/state/",
        "role": "mutable-cache",
        "truth": "none; delete-safe cache only",
        "llmLoadPolicy": "inspect only to diagnose hooks/gates; never cite as durable evidence",
        "stalenessRisk": "high",
        "portingRule": "do not copy except placeholders"
      },
      {
        "path": ".codex/workflow/runtime/",
        "role": "runtime-telemetry",
        "truth": "none until embedded into durable records",
        "llmLoadPolicy": "inspect only for command/hook diagnostics",
        "stalenessRisk": "high",
        "portingRule": "do not copy except placeholders"
      }
    ],
    "scriptExtensions": [
      ".mjs"
    ],
    "agentExtensions": [
      ".toml"
    ],
    "knowledgeExtensions": [
      ".md"
    ],
    "templateExtensions": [
      ".md"
    ],
    "researchExtensions": [
      ".md"
    ],
    "briefExtensions": [
      ".md"
    ],
    "scenarioFiles": [
      ".codex/workflow/scenarios/model-routing.json"
    ]
  },
  "handover": {
    "path": ".codex/workflow/current-state.md",
    "maxLines": 140,
    "maxBytes": 12000,
    "maxCompletedHistoryBullets": 12
