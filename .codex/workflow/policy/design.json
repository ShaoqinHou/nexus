{
  "schema": "nexus-design-workflow-policy/v1",
  "zooVisualGuideVersion": "nexus-design-zoo-visual-guide/v1",
  "zooVisualManifestSchema": "nexus-design-zoo-visual-manifest/v1",
  "zooVisualGuideTitle": "Nexus Design Zoo / Gym",
  "zooVisualSurfaceLabel": "Visual Demo Surface",
  "zooVisualGuideRequiredStrings": [
    "Nexus Design Zoo / Gym",
    "Visual Demo Surface",
    "Captured From Real /design Routes",
    "Visual Contexts",
    "Token Foundations",
    "Theme Matrix",
    "Component Gallery",
    "packages/web/src/routes/__design/Zoo.tsx",
    "packages/web/src/components/registry.json"
  ],
  "localWebUrl": "http://localhost:5173",
  "designRoute": "/design",
  "productionDesignPath": "/nexus/design",
  "registryPath": "packages/web/src/components/registry.json",
  "zooRoutePath": "packages/web/src/routes/__design/Zoo.tsx",
  "themeMatrixPath": "packages/web/src/platform/theme/themes.css",
  "themeDirectoryPath": "packages/web/src/platform/theme/themes",
  "zooVisualMinImages": 50,
  "zooVisualCapture": {
    "defaultTheme": "sichuan",
    "waitForText": "Zoo",
    "foundations": [
      {
        "slug": "index",
        "title": "Zoo Index",
        "kind": "foundation",
        "route": "/design",
        "path": "packages/web/src/routes/__design/Zoo.tsx",
        "purpose": "Entry page for the live component catalog."
      },
      {
        "slug": "tokens",
        "title": "Token Foundations",
        "kind": "foundation",
        "route": "/design/tokens",
        "path": "packages/web/src/platform/theme/tokens.css",
        "purpose": "Production token swatches for colors, radii, shadows, and hit targets."
      },
      {
        "slug": "themes",
        "title": "Theme Matrix",
        "kind": "foundation",
        "route": "/design/themes",
        "path": "packages/web/src/platform/theme/themes.css",
        "purpose": "All cuisine themes rendered side by side from real components."
      }
    ],
    "contexts": [
      {
        "id": "desktop-light-{theme}",
        "label": "Desktop light {theme}",
        "mode": "light",
        "theme": "{theme}",
        "viewport": {
          "width": 1360,
          "height": 860
        }
      },
      {
        "id": "mobile-dark-{theme}",
        "label": "Mobile dark {theme}",
        "mode": "dark",
        "theme": "{theme}",
        "viewport": {
          "width": 390,
          "height": 844
        }
      }
    ],
    "interactiveShowcases": {
      "toast": {
        "buttonName": "+ Warning",
        "expectedText": "Ingredient threshold reached.",
        "expectedPortalSelector": "[role=\"alert\"]"
      },
      "dialog": {
        "buttonName": "Open dialog",
        "expectedRole": "dialog",
        "expectedText": "Confirm action"
      },
      "tour-overlay": {
        "buttonName": "Start tour",
        "expectedText": "Welcome to Nexus",
        "expectedPortalSelector": "[data-tour-overlay]"
      },
      "themed-empty-state": {
        "expectedTexts": ["Your cart is empty", "Browse menu"]
      },
      "themed-toast": {
        "expectedRole": "status",
        "expectedTexts": ["Order placed", "Low stock", "Payment failed", "Kitchen connected"]
      }
    }
  },
  "tokenSource": {
    "file": "packages/web/src/platform/theme/tokens.css",
    "publicGuideTokens": [
      "--color-bg-surface",
      "--color-bg-muted",
      "--color-bg-elevated",
      "--color-bg-strong",
      "--color-text",
      "--color-text-secondary",
      "--color-text-inverse",
      "--color-border",
      "--color-primary",
      "--color-primary-light",
      "--color-danger",
      "--color-accent",
      "--radius-md",
      "--radius-lg",
      "--radius-full",
      "--radius-card",
      "--radius-btn",
      "--radius-chip",
      "--hit-sm",
      "--hit-md",
      "--hit-lg"
    ]
  },
  "visualSourceFiles": [
    ".codex/scripts/workflow-engine.mjs",
    ".codex/scripts/nexus-workflow.mjs",
    ".codex/scripts/capture-design-zoo-visuals.mjs",
    ".codex/scripts/validate-theme-settings-preview.mjs",
    ".codex/knowledge/design-system.md",
    ".codex/workflow/policy/design.json",
    "packages/web/src/components/registry.json",
    "packages/web/src/routes/__design/Zoo.tsx",
    "packages/web/src/platform/theme/tokens.css",
    "packages/web/src/platform/theme/themes.css"
  ],
  "visualSourceDirectories": [
    {
      "path": "packages/web/src/components/patterns",
      "maxDepth": 8,
      "limit": 600
    },
    {
      "path": "packages/web/src/components/ui",
      "maxDepth": 8,
      "limit": 600
    },
    {
      "path": "packages/web/src/platform/theme/themes",
      "maxDepth": 2,
      "limit": 64
    }
  ]
}
