{
  "schema": "codex-workflow-guide-policy/v1",
  "version": "nexus-public-workflow-guide/v2",
  "contentHashPlaceholder": "__NEXUS_GUIDE_CONTENT_HASH__",
  "metaNames": {
    "version": "nexus-guide-version",
    "sourceHash": "nexus-guide-source-hash",
    "recordFeedHash": "nexus-guide-record-feed-hash",
    "contentHash": "nexus-guide-content-hash",
    "tokenSource": "nexus-token-source"
  },
  "tokenSourceLabel": "packages/web/src/platform/theme/tokens.css",
  "titles": {
    "dashboard": "Nexus Workflow Dashboard",
    "public": "Nexus Workflow Guide"
  },
  "publicSanitizer": {
    "redactions": [
      {
        "literal": "{rootPosix}",
        "replacement": "local worktree"
      },
      {
        "literal": "{root}",
        "replacement": "local worktree"
      },
      {
        "pattern": "C:\\\\Users\\\\[^\\\\\\s]+\\\\\\.codex\\\\worktrees\\\\\\d+\\\\nexus",
        "flags": "gi",
        "replacement": "local worktree"
      },
      {
        "pattern": "\\/root\\/monoWeb\\/nexus",
        "flags": "g",
        "replacement": "server repo"
      },
      {
        "pattern": "\\/root\\/monoWeb\\/deploy-backups\\/[^\\s)]+",
        "flags": "g",
        "replacement": "server backup path"
      },
      {
        "pattern": "~\\/\\.ssh\\/[^\\s)`]+",
        "flags": "g",
        "replacement": "configured SSH key"
      },
      {
        "pattern": "\\b[A-Za-z0-9._-]+@(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
        "flags": "g",
        "replacement": "configured SSH endpoint"
      },
      {
        "pattern": "\\broot@",
        "flags": "g",
        "replacement": "ssh-user@"
      },
      {
        "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
        "flags": "g",
        "replacement": "production server"
      },
      {
        "pattern": "(token|secret|password|api[_-]?key)=([^&\\s]+)",
        "flags": "gi",
        "replacement": "$1=redacted"
      }
    ],
    "forbiddenStrings": [
      "{root}",
      "{rootPosix}",
      "/root/monoWeb/nexus",
      "/root/monoWeb/deploy-backups",
      "http://localhost",
      "https://localhost",
      "127.0.0.1",
      "localhost",
      "~/.ssh/",
      "DIOkii",
      "root@",
      "134.199.148.87"
    ]
  },
  "artifacts": [
    "index.html",
    "public.html",
    "zoo/index.html",
    "zoo/manifest.json"
  ],
  "generatedSizeLimits": {
    "index.html": 716800,
    "public.html": 262144
  },
  "ladderMentionFiles": [
    "AGENTS.md",
    "WORKFLOW.md",
    ".codex/README.md"
  ],
  "dashboardKnowledgeSections": [
    {
      "id": "patterns",
      "title": "Patterns",
      "file": ".codex/knowledge/patterns.md"
    },
    {
      "id": "design",
      "title": "Design System",
      "file": ".codex/knowledge/design-system.md"
    },
    {
      "id": "deployment",
      "title": "Deployment",
      "file": ".codex/knowledge/deployment.md"
    }
  ],
  "sessionStart": {
    "readDocs": [
      ".codex/README.md",
      "{currentState}",
      "closest relevant .codex/knowledge file"
    ],
    "statusCommand": "node .codex/scripts/nexus-workflow.mjs status"
  },
  "resume": {
    "readDocs": [
      "WORKFLOW.md",
      "AGENTS.md",
      ".codex/workflow/current-state.md"
    ],
    "permissionAdvice": "Use trusted Custom (config.toml) when project hooks matter. Full access grants permissions but does not prove hooks/config loaded; diagnose with npm run workflow:hook-runtime-check and bootstrap new projects from .codex/workflow/templates/project-bootstrap.md.",
    "branchCloseoutCommands": [
      "node .codex/scripts/nexus-workflow.mjs close-work-slice --slice <WORK-SLICE-id> --status done --notes \"<evidence complete>\"",
      "node .codex/scripts/nexus-workflow.mjs record-patch --scope branch --summary \"<branch summary>\" --worker <lead-worker> --work-slice <WORK-SLICE-id>",
      "node .codex/scripts/nexus-workflow.mjs record-review --scope branch --kind general --verdict pass --reviewer <name> --work-slice <WORK-SLICE-id> --notes \"<summary>\"",
      "node .codex/scripts/nexus-workflow.mjs record-verify --scope branch --verdict pass --verifier <name> --work-slice <WORK-SLICE-id> --commands \"<timed-command-ids>\" --notes \"<commands/results>\"",
      "node .codex/scripts/nexus-workflow.mjs record-audit --scope branch --verdict pass --auditor <name> --work-slice <WORK-SLICE-id> --commands \"<timed-command-ids>\" --notes \"<summary>\""
    ]
  },
  "recordFeedExcludeKinds": [
    "deployments"
  ],
  "displayOnlyRecordKinds": [
    "deployments"
  ],
  "recordEmbedExcludeKinds": [
    "deployments"
  ],
  "recordEmbedExcludedCountLabels": {
    "deployments": "gate"
  },
  "selfReferentialWarningFilters": [
    {
      "kind": "deployments",
      "includes": "requires deployment but has no linked passing deployment record"
    }
  ],
  "displayOnlyRecordNotice": "Deployment records are gate-only in generated guide artifacts. Append-only deployment records plus workflow:deployed-gate are the authoritative deployment proof.",
  "publicTimeline": {
    "excludeKinds": [
      "deployments"
    ]
  },
