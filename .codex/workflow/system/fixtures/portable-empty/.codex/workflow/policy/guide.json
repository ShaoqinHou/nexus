          "Project Policy",
          "System Kernel"
        ]
      ]
    }
  },
  "viewContract": {
    "requiredStrings": [
      "Workflow Shape",
      "Workflow System Nodes",
      "How Future Sessions Resume"
    ],
    "timelineCategoryHeadings": [],
